#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include "framework/core/MLUStream.h"

__mlu_entry__ void gemv_half_kernel(const half *A, const half *B, half *C, int rows, int cols) {
    uint32_t row = taskId;
    uint32_t row_step = taskDim;

    for (; row < rows; row += row_step) {
        float sum = 0.0f;
        const half *row_a = A + row * cols;
        for (int col = 0; col < cols; ++col) {
            sum += (float)row_a[col] * (float)B[col];
        }
        C[row] = (half)sum;
    }
}

__mlu_entry__ void gemv_float_kernel(const float *A, const float *B, float *C, int rows, int cols) {
    uint32_t row = taskId;
    uint32_t row_step = taskDim;

    for (; row < rows; row += row_step) {
        float sum = 0.0f;
        const float *row_a = A + row * cols;
        for (int col = 0; col < cols; ++col) {
            sum += row_a[col] * B[col];
        }
        C[row] = sum;
    }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    auto a = A.contiguous();
    auto b = B.contiguous();
    TORCH_CHECK(a.dim() == 2 && b.dim() == 2 && b.size(1) == 1, "GEMV expects A=[M,K], B=[K,1]");
    TORCH_CHECK(a.size(1) == b.size(0), "GEMV dimension mismatch");
    auto output = torch::empty({a.size(0), 1}, a.options());
    int rows = a.size(0);
    int cols = a.size(1);
    if (rows == 0 || cols == 0) {
        return output;
    }

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {256, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    if (a.scalar_type() == at::ScalarType::Half) {
        gemv_half_kernel<<<dim, ktype, queue>>>(
            reinterpret_cast<const half *>(a.data_ptr<at::Half>()),
            reinterpret_cast<const half *>(b.data_ptr<at::Half>()),
            reinterpret_cast<half *>(output.data_ptr<at::Half>()),
            rows,
            cols);
    } else {
        TORCH_CHECK(a.scalar_type() == at::ScalarType::Float, "GEMV only supports float16 and float32");
        gemv_float_kernel<<<dim, ktype, queue>>>(
            a.data_ptr<float>(),
            b.data_ptr<float>(),
            output.data_ptr<float>(),
            rows,
            cols);
    }

    return output;
}
