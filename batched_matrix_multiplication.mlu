#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include "framework/core/MLUStream.h"

__mlu_entry__ void bmm_half_kernel(const half *A, const half *B, float *C, int batch, int m, int k, int n) {
    long total = (long)batch * m * n;
    for (long idx = taskId; idx < total; idx += taskDim) {
        int col = idx % n;
        long t = idx / n;
        int row = t % m;
        int b = t / m;
        float sum = 0.0f;
        long a_base = ((long)b * m + row) * k;
        long b_base = (long)b * k * n + col;
        for (int kk = 0; kk < k; ++kk) {
            sum += (float)A[a_base + kk] * (float)B[b_base + (long)kk * n];
        }
        C[idx] = sum;
    }
}

__mlu_entry__ void bmm_float_kernel(const float *A, const float *B, float *C, int batch, int m, int k, int n) {
    long total = (long)batch * m * n;
    for (long idx = taskId; idx < total; idx += taskDim) {
        int col = idx % n;
        long t = idx / n;
        int row = t % m;
        int b = t / m;
        float sum = 0.0f;
        long a_base = ((long)b * m + row) * k;
        long b_base = (long)b * k * n + col;
        for (int kk = 0; kk < k; ++kk) {
            sum += A[a_base + kk] * B[b_base + (long)kk * n];
        }
        C[idx] = sum;
    }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    auto a = A.contiguous();
    auto b = B.contiguous();
    TORCH_CHECK(a.dim() == 3 && b.dim() == 3, "bmm expects 3D tensors");
    int batch = a.size(0), m = a.size(1), k = a.size(2), n = b.size(2);
    auto options = a.scalar_type() == at::ScalarType::Half ? a.options().dtype(torch::kFloat) : a.options();
    auto output = torch::empty({batch, m, n}, options);
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t task_dim = {256, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    if (a.scalar_type() == at::ScalarType::Half) {
        bmm_half_kernel<<<task_dim, ktype, queue>>>(
            reinterpret_cast<const half *>(a.data_ptr<at::Half>()),
            reinterpret_cast<const half *>(b.data_ptr<at::Half>()),
            output.data_ptr<float>(),
            batch, m, k, n);
    } else {
        TORCH_CHECK(a.scalar_type() == at::ScalarType::Float, "bmm only supports float16 and float32");
        bmm_float_kernel<<<task_dim, ktype, queue>>>(a.data_ptr<float>(), b.data_ptr<float>(), output.data_ptr<float>(), batch, m, k, n);
    }
    return output;
}
