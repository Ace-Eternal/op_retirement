#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include "framework/core/MLUStream.h"

__mlu_entry__ void scatter_add_half_kernel(const half *src, const int64_t *index, float *output, int n, int d, int dim_size) {
    if (taskId != 0) {
        return;
    }
    for (int i = 0; i < dim_size * d; ++i) {
        output[i] = 0.0f;
    }
    for (int row = 0; row < n; ++row) {
        int dst = (int)index[row];
        for (int col = 0; col < d; ++col) {
            int pos = dst * d + col;
            output[pos] += (float)src[row * d + col];
        }
    }
}

__mlu_entry__ void scatter_add_float_kernel(const float *src, const int64_t *index, float *output, int n, int d, int dim_size) {
    if (taskId != 0) {
        return;
    }
    for (int i = 0; i < dim_size * d; ++i) {
        output[i] = 0.0f;
    }
    for (int row = 0; row < n; ++row) {
        int dst = (int)index[row];
        for (int col = 0; col < d; ++col) {
            output[dst * d + col] += src[row * d + col];
        }
    }
}

torch::Tensor bang_func(torch::Tensor src, torch::Tensor index, int dim_size) {
    auto input = src.contiguous();
    auto idx = index.contiguous();
    TORCH_CHECK(input.dim() == 2 && idx.dim() == 1, "Scatter_add expects src=[N,D], index=[N]");
    TORCH_CHECK(idx.scalar_type() == at::ScalarType::Long, "Scatter_add expects int64 index");
    auto output = input.scalar_type() == at::ScalarType::Half
        ? torch::empty({dim_size, input.size(1)}, input.options().dtype(torch::kFloat))
        : torch::empty({dim_size, input.size(1)}, input.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t task_dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    int n = input.size(0);
    int d = input.size(1);

    if (input.scalar_type() == at::ScalarType::Half) {
        scatter_add_half_kernel<<<task_dim, ktype, queue>>>(
            reinterpret_cast<const half *>(input.data_ptr<at::Half>()),
            idx.data_ptr<int64_t>(),
            output.data_ptr<float>(),
            n,
            d,
            dim_size);
    } else {
        TORCH_CHECK(input.scalar_type() == at::ScalarType::Float, "Scatter_add only supports float16 and float32");
        scatter_add_float_kernel<<<task_dim, ktype, queue>>>(
            input.data_ptr<float>(),
            idx.data_ptr<int64_t>(),
            output.data_ptr<float>(),
            n,
            d,
            dim_size);
    }

    return output;
}
