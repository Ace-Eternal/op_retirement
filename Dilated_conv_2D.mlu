#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include "framework/core/MLUStream.h"

__mlu_entry__ void dilated_conv2d_half_kernel(const half *x, const half *kernel, float *out, int batch, int in_c, int out_c, int h, int w, int k, int dilation, int padding, int out_h, int out_w) {
    long total = (long)batch * out_c * out_h * out_w;
    for (long idx = taskId; idx < total; idx += taskDim) {
        int ow = idx % out_w;
        long t = idx / out_w;
        int oh = t % out_h;
        t /= out_h;
        int oc = t % out_c;
        int b = t / out_c;
        float sum = 0.0f;
        for (int ic = 0; ic < in_c; ++ic) {
            for (int kh = 0; kh < k; ++kh) {
                int ih = oh - padding + kh * dilation;
                if (ih < 0 || ih >= h) continue;
                for (int kw = 0; kw < k; ++kw) {
                    int iw = ow - padding + kw * dilation;
                    if (iw < 0 || iw >= w) continue;
                    sum += (float)x[((b * in_c + ic) * h + ih) * w + iw] * (float)kernel[((oc * in_c + ic) * k + kh) * k + kw];
                }
            }
        }
        out[idx] = sum;
    }
}

torch::Tensor bang_func(torch::Tensor x, torch::Tensor kernel, int in_channels, int out_channels, int kernel_size, int dilation, int padding) {
    auto input = x.contiguous();
    auto weight = kernel.contiguous();
    int batch = input.size(0), h = input.size(2), w = input.size(3);
    int out_h = h + 2 * padding - dilation * (kernel_size - 1);
    int out_w = w + 2 * padding - dilation * (kernel_size - 1);
    auto output = torch::empty({batch, out_channels, out_h, out_w}, input.options().dtype(torch::kFloat));
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t task_dim = {256, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    TORCH_CHECK(input.scalar_type() == at::ScalarType::Half, "Dilated_conv_2D basic task expects float16");
    dilated_conv2d_half_kernel<<<task_dim, ktype, queue>>>(
        reinterpret_cast<const half *>(input.data_ptr<at::Half>()),
        reinterpret_cast<const half *>(weight.data_ptr<at::Half>()),
        output.data_ptr<float>(),
        batch, in_channels, out_channels, h, w, kernel_size, dilation, padding, out_h, out_w);
    return output;
}
