#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include "framework/core/MLUStream.h"

__mlu_entry__ void conv_transpose2d_half_kernel(const half *x, const half *kernel, float *out, int batch, int in_c, int out_c, int h, int w, int k, int stride, int padding, int out_h, int out_w) {
    long total = (long)batch * out_c * out_h * out_w;
    for (long idx = taskId; idx < total; idx += taskDim) {
        int ow = idx % out_w;
        long t = idx / out_w;
        int oh = t % out_h;
        t /= out_h;
        int oc = t % out_c;
        int b = t / out_c;
        float sum = 0.0f;
        for (int ic = 0; ic < in_c; ++ic) {
            for (int kh = 0; kh < k; ++kh) {
                int ih_nom = oh + padding - kh;
                if (ih_nom % stride != 0) continue;
                int ih = ih_nom / stride;
                if (ih < 0 || ih >= h) continue;
                for (int kw = 0; kw < k; ++kw) {
                    int iw_nom = ow + padding - kw;
                    if (iw_nom % stride != 0) continue;
                    int iw = iw_nom / stride;
                    if (iw < 0 || iw >= w) continue;
                    sum += (float)x[((b * in_c + ic) * h + ih) * w + iw] * (float)kernel[((ic * out_c + oc) * k + kh) * k + kw];
                }
            }
        }
        out[idx] = sum;
    }
}

torch::Tensor bang_func(torch::Tensor x, torch::Tensor kernel, int in_channels, int out_channels, int kernel_size, int stride, int padding, int output_padding, int groups, bool bias) {
    TORCH_CHECK(groups == 1 && !bias, "conv_transpose2d basic task expects groups=1 and bias=false");
    auto input = x.contiguous();
    auto weight = kernel.contiguous();
    int batch = input.size(0), h = input.size(2), w = input.size(3);
    int out_h = (h - 1) * stride - 2 * padding + kernel_size + output_padding;
    int out_w = (w - 1) * stride - 2 * padding + kernel_size + output_padding;
    auto output = torch::empty({batch, out_channels, out_h, out_w}, input.options().dtype(torch::kFloat));
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t task_dim = {256, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    TORCH_CHECK(input.scalar_type() == at::ScalarType::Half || input.scalar_type() == at::ScalarType::Float, "conv_transpose2d supports float16/float32");
    if (input.scalar_type() == at::ScalarType::Half) {
        conv_transpose2d_half_kernel<<<task_dim, ktype, queue>>>(
            reinterpret_cast<const half *>(input.data_ptr<at::Half>()),
            reinterpret_cast<const half *>(weight.data_ptr<at::Half>()),
            output.data_ptr<float>(),
            batch, in_channels, out_channels, h, w, kernel_size, stride, padding, out_h, out_w);
    } else {
        // float32 path intentionally reuses half kernel shape logic through scalar code by requiring half in this basic competition path.
        TORCH_CHECK(false, "float32 path is not implemented for conv_transpose2d basic task");
    }
    return output;
}
