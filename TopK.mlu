#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <vector>
#include "framework/core/MLUStream.h"

#define MAX_K 64

__mlu_entry__ void topk_dim1_half_kernel(const half *input, half *values, int64_t *indices, int rows, int cols, int k) {
    for (int row = taskId; row < rows; row += taskDim) {
        float best_values[MAX_K];
        int64_t best_indices[MAX_K];
        for (int i = 0; i < k; ++i) {
            best_values[i] = -3.402823466e38f;
            best_indices[i] = 0;
        }

        int base = row * cols;
        for (int col = 0; col < cols; ++col) {
            float value = (float)input[base + col];
            for (int pos = 0; pos < k; ++pos) {
                if (value > best_values[pos]) {
                    for (int move = k - 1; move > pos; --move) {
                        best_values[move] = best_values[move - 1];
                        best_indices[move] = best_indices[move - 1];
                    }
                    best_values[pos] = value;
                    best_indices[pos] = col;
                    break;
                }
            }
        }

        int out_base = row * k;
        for (int i = 0; i < k; ++i) {
            values[out_base + i] = (half)best_values[i];
            indices[out_base + i] = best_indices[i];
        }
    }
}

__mlu_entry__ void topk_dim1_float_kernel(const float *input, float *values, int64_t *indices, int rows, int cols, int k) {
    for (int row = taskId; row < rows; row += taskDim) {
        float best_values[MAX_K];
        int64_t best_indices[MAX_K];
        for (int i = 0; i < k; ++i) {
            best_values[i] = -3.402823466e38f;
            best_indices[i] = 0;
        }

        int base = row * cols;
        for (int col = 0; col < cols; ++col) {
            float value = input[base + col];
            for (int pos = 0; pos < k; ++pos) {
                if (value > best_values[pos]) {
                    for (int move = k - 1; move > pos; --move) {
                        best_values[move] = best_values[move - 1];
                        best_indices[move] = best_indices[move - 1];
                    }
                    best_values[pos] = value;
                    best_indices[pos] = col;
                    break;
                }
            }
        }

        int out_base = row * k;
        for (int i = 0; i < k; ++i) {
            values[out_base + i] = best_values[i];
            indices[out_base + i] = best_indices[i];
        }
    }
}

std::vector<torch::Tensor> bang_func(torch::Tensor x, int k, int dim) {
    TORCH_CHECK(dim == 1, "TopK supports dim=1 for the basic task");
    TORCH_CHECK(k > 0 && k <= MAX_K, "TopK k is out of supported range");
    auto input = x.contiguous();
    TORCH_CHECK(input.dim() == 2, "TopK expects [batch, dim]");
    auto values = torch::empty({input.size(0), k}, input.options());
    auto indices = torch::empty({input.size(0), k}, input.options().dtype(torch::kLong));

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t task_dim = {16, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    int rows = input.size(0);
    int cols = input.size(1);

    if (input.scalar_type() == at::ScalarType::Half) {
        topk_dim1_half_kernel<<<task_dim, ktype, queue>>>(
            reinterpret_cast<const half *>(input.data_ptr<at::Half>()),
            reinterpret_cast<half *>(values.data_ptr<at::Half>()),
            indices.data_ptr<int64_t>(),
            rows,
            cols,
            k);
    } else {
        TORCH_CHECK(input.scalar_type() == at::ScalarType::Float, "TopK only supports float16 and float32");
        topk_dim1_float_kernel<<<task_dim, ktype, queue>>>(
            input.data_ptr<float>(),
            values.data_ptr<float>(),
            indices.data_ptr<int64_t>(),
            rows,
            cols,
            k);
    }

    return {values, indices};
}
