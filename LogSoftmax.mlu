#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <math.h>
#include "framework/core/MLUStream.h"

__mlu_entry__ void logsoftmax_half_kernel(const half *input, half *output, int rows, int cols) {
    uint32_t row = taskId;
    uint32_t row_step = taskDim;

    for (; row < rows; row += row_step) {
        const half *row_input = input + row * cols;
        half *row_output = output + row * cols;

        // 每行在 scalar 路径中做 max 与 sum，避免 16384 列超出简单向量模板的假设。
        float max_value = (float)row_input[0];
        for (int col = 1; col < cols; ++col) {
            float value = (float)row_input[col];
            if (value > max_value) {
                max_value = value;
            }
        }

        float sum_value = 0.0f;
        for (int col = 0; col < cols; ++col) {
            sum_value += expf((float)row_input[col] - max_value);
        }

        float log_sum = logf(sum_value);
        for (int col = 0; col < cols; ++col) {
            row_output[col] = (half)(((float)row_input[col] - max_value) - log_sum);
        }
    }
}

__mlu_entry__ void logsoftmax_float_kernel(const float *input, float *output, int rows, int cols) {
    uint32_t row = taskId;
    uint32_t row_step = taskDim;

    for (; row < rows; row += row_step) {
        const float *row_input = input + row * cols;
        float *row_output = output + row * cols;

        float max_value = row_input[0];
        for (int col = 1; col < cols; ++col) {
            float value = row_input[col];
            if (value > max_value) {
                max_value = value;
            }
        }

        float sum_value = 0.0f;
        for (int col = 0; col < cols; ++col) {
            sum_value += expf(row_input[col] - max_value);
        }

        float log_sum = logf(sum_value);
        for (int col = 0; col < cols; ++col) {
            row_output[col] = (row_input[col] - max_value) - log_sum;
        }
    }
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
    TORCH_CHECK(dim == 1 || dim == -1, "LogSoftmax currently supports dim=1/-1 for [batch, dim] input");
    auto input = x.contiguous();
    TORCH_CHECK(input.dim() == 2, "LogSoftmax expects a 2D tensor");
    auto output = torch::empty_like(input);
    int rows = input.size(0);
    int cols = input.size(1);
    if (rows == 0 || cols == 0) {
        return output;
    }

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t task_dim = {16, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    if (input.scalar_type() == at::ScalarType::Half) {
        logsoftmax_half_kernel<<<task_dim, ktype, queue>>>(
            reinterpret_cast<const half *>(input.data_ptr<at::Half>()),
            reinterpret_cast<half *>(output.data_ptr<at::Half>()),
            rows,
            cols);
    } else {
        TORCH_CHECK(input.scalar_type() == at::ScalarType::Float, "LogSoftmax only supports float16 and float32");
        logsoftmax_float_kernel<<<task_dim, ktype, queue>>>(
            input.data_ptr<float>(),
            output.data_ptr<float>(),
            rows,
            cols);
    }

    return output;
}
